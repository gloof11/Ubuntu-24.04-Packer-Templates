#cloud-config
autoinstall:
  version: 1
  locale: en_US
  keyboard:
    layout: us
  ssh:
    install-server: true
    allow-pw: true
    allow_public_ssh_keys: true
  packages:
    - qemu-guest-agent
    - sudo
  storage:
    layout:
      name: direct
  user-data:
    package_upgrade: false
    timezone: America/New_York # Set your Timezone
    users:
      - name: # Set your default username
        groups: [adm, sudo]
        lock-passwd: false
        sudo: ALL=(ALL) NOPASSWD:ALL
        shell: /bin/bash
        ssh_authorized_keys:
          # Put your ssh key here
          # For example:
          # - ssh-ed25519 ... example@example.com